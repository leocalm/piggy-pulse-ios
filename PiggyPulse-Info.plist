<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pt-BR</string>
		<string>pt-PT</string>
		<string>es-ES</string>
		<string>nl-NL</string>
		<string>de-DE</string>
		<string>fr-FR</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.piggypulse.notifications.refresh</string>
	</array>
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
