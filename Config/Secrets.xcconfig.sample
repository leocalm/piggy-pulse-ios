// Template for Config/Secrets.xcconfig.
// Copy this file to Secrets.xcconfig and fill in real values. The copy is
// gitignored.
//
// Note: xcconfig treats `//` as a comment, so embed `$()` between the scheme
// and the slashes in any URL value to escape it
// (e.g. https:$()//example.com/...).
//
// SENTRY_DSN          — runtime DSN, read at app startup via Info.plist.
// SENTRY_AUTH_TOKEN   — sentry-cli auth token for the dSYM upload Run Script.
//                       Generate at sentry.io > User Auth Tokens
//                       (needs project:read + project:releases scopes).
// SENTRY_ORG          — Sentry org slug (the one in your sentry.io URL).
// SENTRY_PROJECT      — Sentry project slug.

SENTRY_DSN =
SENTRY_AUTH_TOKEN =
SENTRY_ORG =
SENTRY_PROJECT =
