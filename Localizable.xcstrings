            "state": "translated",
            "value": "não rotulamos gastos como bons ou maus"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "não rotulamos os gastos como bons ou maus"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "no etiquetamos el gasto como bueno o malo"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "we labelen uitgaven niet als goed of slecht"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir bewerten Ausgaben nicht als gut oder schlecht."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne jugeons pas vos dépenses"
          }
        }
      }
    },
    "welcome.quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PiggyPulse shows you reality through data. We don't celebrate or criticize — you decide what your numbers mean."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PiggyPulse te mostra a realidade através dos dados. Não celebramos nem criticamos — você decide o que seus números significam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PiggyPulse mostra-lhe a realidade através dos dados. Não celebramos nem criticamos — é você que decide o que os seus números significam."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "PiggyPulse te muestra la realidad a través de los datos. No celebramos ni criticamos: tú decides lo que significan tus números."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "PiggyPulse laat je via data zien hoe het er echt voor staat. We oordelen niet — jij bepaalt wat je cijfers betekenen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "PiggyPulse zeigt dir deine finanzielle Realität in Zahlen. Wir loben nicht und kritisieren nicht — du entscheidest, was deine Zahlen bedeuten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "PiggyPulse vous montre vos finances telles qu’elles sont. Pas de jugement, pas de célébration forcée : c’est vous qui décidez du sens de vos chiffres."
          }
        }
      }
    },
    "welcome.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your financial pulse — calm, clear, and entirely yours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu pulso financeiro — calmo, claro e inteiramente seu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu pulso financeiro — calmo, claro e inteiramente seu."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso financiero: tranquilo, claro y totalmente tuyo."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je financiële pols — kalm, helder en helemaal van jou."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein finanzieller Puls — ruhig, klar und ganz bei dir."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pouls de vos finances — calme, clair, et entièrement à vous."
