    "settings.feedbackDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us make PiggyPulse better — bugs, ideas, translation fixes, anything."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a melhorar o PiggyPulse — bugs, ideias, traduções, o que quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude-nos a melhorar o PiggyPulse — erros, ideias, correções de tradução, qualquer coisa."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdanos a mejorar PiggyPulse: errores, ideas, correcciones de traducción, lo que sea."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Help ons PiggyPulse beter te maken — bugs, ideeën, vertaalfixes, alles welkom."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
