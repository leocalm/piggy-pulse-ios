    "vendors.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendors help you track where your money goes. Add your first vendor to start categorizing spending."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornecedores ajudam a rastrear para onde seu dinheiro vai. Adicione seu primeiro fornecedor para categorizar gastos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comerciantes ajudam-no a perceber para onde vai o seu dinheiro. Adicione o primeiro para começar a categorizar gastos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comercios te ayudan a saber adónde va tu dinero. Añade tu primer comercio para empezar a clasificar el gasto."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkopers helpen je te zien waar je geld naartoe gaat. Voeg je eerste verkoper toe om uitgaven te ordenen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Händler helfen dir nachzuvollziehen, wohin dein Geld fließt. Füge deinen ersten Händler hinzu, um Ausgaben zu kategorisieren."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bénéficiaires vous aident à voir où va votre argent. Ajoutez votre premier bénéficiaire pour commencer à classer vos dépenses."
          }
        }
      }
    },
    "vendors.empty.step1.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the name of a store, service, or payee you regularly transact with."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o nome de uma loja, serviço ou beneficiário com quem você transaciona regularmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o nome de uma loja, serviço ou entidade com quem transaciona regularmente."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el nombre de una tienda, un servicio o un beneficiario que uses habitualmente."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de naam toe van een winkel, dienst of begunstigde waarmee je regelmatig transacties doet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage den Namen eines Geschäfts, Dienstes oder Empfängers ein, mit dem du regelmäßig Buchungen hast."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le nom d’un magasin, service ou bénéficiaire avec lequel vous effectuez régulièrement des transactions."
          }
        }
      }
    },
