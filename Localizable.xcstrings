    "subscriptions.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your recurring charges like streaming services, memberships, and bills."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe suas cobranças recorrentes como serviços de streaming, mensalidades e contas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe os seus débitos recorrentes, como serviços de streaming, adesões e contas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla tus cargos recurrentes, como servicios de streaming, membresías y facturas."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd terugkerende kosten in de gaten, zoals streamingdiensten, lidmaatschappen en rekeningen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deine wiederkehrenden Abbuchungen, etwa Streamingdienste, Mitgliedschaften und Rechnungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos prélèvements récurrents, comme les services de streaming, les abonnements et les factures."
          }
        }
      }
    },
    "subscriptions.empty.step1.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the service name, billing amount, and how often you are charged."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira o nome do serviço, valor da cobrança e a frequência da cobrança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o nome do serviço, o valor da faturação e a periodicidade dos débitos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el nombre del servicio, el importe y con qué frecuencia se cobra."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de naam van de dienst, het factuurbedrag en de frequentie van de afschrijving in."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Namen des Dienstes, den Betrag und die Häufigkeit der Abbuchung ein."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nom du service, le montant facturé et la fréquence des prélèvements."
          }
        }
      }
    },
