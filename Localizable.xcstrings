    "subscriptions.empty.tip1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions are separate from regular transactions — they represent recurring commitments."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinaturas são separadas das transações regulares — representam compromissos recorrentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As subscrições são separadas das transações normais — representam compromissos recorrentes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se separan de los movimientos normales: representan compromisos recurrentes."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen staan los van gewone transacties — ze vertegenwoordigen terugkerende verplichtingen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos sind getrennt von normalen Buchungen — sie stehen für wiederkehrende Verpflichtungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements sont distincts des transactions classiques — ils représentent des engagements récurrents."
          }
        }
      }
    },
    "subscriptions.empty.tip2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once added, upcoming charges appear on this page so you can plan ahead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez adicionadas, as próximas cobranças aparecem nesta página para você se planejar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de adicionados, os próximos débitos aparecem nesta página para que possa planear-se."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez añadidos, los próximos cargos aparecen en esta página para que puedas planificar."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra ze zijn toegevoegd, verschijnen aankomende afschrijvingen op deze pagina zodat je vooruit kunt plannen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Hinzufügen erscheinen anstehende Abbuchungen auf dieser Seite, damit du vorausplanen kannst."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois ajoutés, les prochains prélèvements apparaissent sur cette page pour vous permettre d’anticiper."
          }
        }
      }
    },
    "subscriptions.empty.tip3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause or cancel subscriptions to track their lifecycle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode pausar ou cancelar assinaturas para acompanhar seu ciclo de vida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode pausar ou cancelar subscrições para acompanhar o seu ciclo de vida."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pausar o cancelar suscripciones para seguir su estado a lo largo del tiempo."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt abonnementen pauzeren of opzeggen om hun levenscyclus te volgen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Abos pausieren oder kündigen, um ihren Lebenszyklus zu verfolgen."
