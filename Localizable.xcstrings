    "tip.transactions.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buchungen sind das Herzstück deines Budgets. Jede ist mit einer Kategorie und einem Konto verknüpft, sodass du in jedem Zeitraum siehst, wohin dein Geld fließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transactions are the core of your budget. Each one is linked to a category and account, which lets you track where your money goes during each period."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los movimientos son la base de tu presupuesto. Cada uno se vincula a una categoría y una cuenta, para que puedas ver adónde va tu dinero en cada periodo."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transactions sont au cœur de votre budget. Chacune est liée à une catégorie et à un compte, ce qui vous permet de voir où va votre argent à chaque période."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transacties zijn de kern van je budget. Elke transactie is gekoppeld aan een categorie en een rekening, zodat je per periode kunt zien waar je geld naartoe gaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transações são o núcleo do seu orçamento. Cada uma é vinculada a uma categoria e conta, permitindo acompanhar para onde seu dinheiro vai em cada período."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As transações são o núcleo do seu orçamento. Cada uma está associada a uma categoria e a uma conta, o que lhe permite ver para onde vai o seu dinheiro em cada período."
          }
        }
      }
    },
