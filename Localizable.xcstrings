    "feedback.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what's working, what isn't, or anything you'd like to share. We read every message."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte o que está funcionando, o que não está ou qualquer ideia que queira compartilhar. A gente lê tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga-nos o que está a funcionar, o que não está ou qualquer ideia que queira partilhar. Lemos todas as mensagens."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué funciona, qué no, o lo que quieras compartir. Leemos todos los mensajes."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel ons wat werkt, wat niet, of waar je verder over wilt vertellen. We lezen elk bericht."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, was funktioniert, was nicht, oder was du sonst noch loswerden möchtest. Wir lesen jede Nachricht."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous ce qui fonctionne, ce qui ne fonctionne pas, ou tout ce que vous voulez partager. Nous lisons chaque message."
          }
        }
      }
    },
