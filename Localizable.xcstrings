    "periods.description1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Periods are time windows that organize your transactions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os períodos organizam suas transações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os períodos são janelas temporais que organizam as suas transações."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los periodos son intervalos de tiempo que organizan tus movimientos."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodes zijn tijdvensters die je transacties ordenen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgetzeiträume strukturieren deine Buchungen nach Zeitfenstern."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les périodes permettent d’organiser vos transactions dans le temps."
          }
        }
      }
    },
    "periods.description2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions fall into periods based on their date — no manual assignment needed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações são atribuídas automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações são atribuídas a períodos com base na data — não é preciso fazer nada manualmente."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los movimientos se asignan a los periodos según su fecha; no hay que asignarlos a mano."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties vallen automatisch in periodes op basis van hun datum — geen handmatige toewijzing nodig."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchungen werden anhand ihres Datums automatisch einem Zeitraum zugeordnet — manuelles Zuweisen entfällt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transactions sont associées automatiquement aux périodes selon leur date. Aucune affectation manuelle n’est nécessaire."
          }
        }
      }
    },
    "periods.empty.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Period"
          }
        },
