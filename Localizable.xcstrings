    "periods.empty.step2.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on automatic period creation so you do not have to manually create them each month."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a criação automática de períodos para não precisar criá-los manualmente todo mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a criação automática de períodos para não ter de os criar manualmente todos os meses."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la creación automática de periodos para no tener que crearlos a mano cada mes."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatisch aanmaken van periodes in, zodat je ze niet elke maand handmatig hoeft te maken."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
