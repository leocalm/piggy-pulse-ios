    "subscriptions.empty.step3.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upcoming charges section shows what is due next and when."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seção de próximas cobranças mostra o que vence em seguida e quando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A secção de próximos débitos mostra o que se segue e quando."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La sección de próximos cargos muestra qué viene a continuación y cuándo."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
