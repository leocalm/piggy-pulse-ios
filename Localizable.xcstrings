    "periods.empty.tip1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A period defines the time window for your budget — most users create monthly periods."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um período define a janela de tempo do seu orçamento — a maioria dos usuários cria períodos mensais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um período define a janela temporal do seu orçamento — a maioria dos utilizadores cria períodos mensais."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un periodo define el intervalo de tiempo de tu presupuesto: la mayoría crea periodos mensuales."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een periode bepaalt het tijdvenster van je budget — de meeste mensen maken maandelijkse periodes aan."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zeitraum definiert das Zeitfenster deines Budgets — die meisten erstellen monatliche Zeiträume."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une période définit la fenêtre temporelle de votre budget — la plupart des utilisateurs créent des périodes mensuelles."
          }
        }
      }
    },
    "periods.empty.tip2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable auto-generation to have new periods created automatically when the current one ends."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a geração automática para criar novos períodos automaticamente quando o atual terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a geração automática para criar novos períodos automaticamente quando o atual terminar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la generación automática para que se creen nuevos periodos cuando termine el actual."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatisch genereren in zodat nieuwe periodes worden aangemaakt zodra de huidige eindigt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die automatische Erstellung, damit neue Zeiträume erstellt werden, sobald der aktuelle endet."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la génération automatique pour créer de nouvelles périodes lorsque l’actuelle se termine."
          }
        }
      }
    },
    "periods.empty.tip3": {
      "localizations": {
        "en": {
