          }
        }
      }
    },
    "welcome.quote" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PiggyPulse zeigt dir deine finanzielle Realität in Zahlen. Wir loben nicht und kritisieren nicht — du entscheidest, was deine Zahlen bedeuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PiggyPulse shows you reality through data. We don't celebrate or criticize — you decide what your numbers mean."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PiggyPulse te muestra la realidad a través de los datos. No celebramos ni criticamos: tú decides lo que significan tus números."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PiggyPulse vous montre vos finances telles qu’elles sont. Pas de jugement, pas de célébration forcée : c’est vous qui décidez du sens de vos chiffres."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PiggyPulse laat je via data zien hoe het er echt voor staat. We oordelen niet — jij bepaalt wat je cijfers betekenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PiggyPulse te mostra a realidade através dos dados. Não celebramos nem criticamos — você decide o que seus números significam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PiggyPulse mostra-lhe a realidade através dos dados. Não celebramos nem criticamos — é você que decide o que os seus números significam."
          }
        }
      }
    },
    "welcome.subtitle" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein finanzieller Puls — ruhig, klar und ganz bei dir."
