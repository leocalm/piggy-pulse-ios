    "subscriptions.empty.step2.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose monthly, quarterly, or yearly billing so upcoming charges are calculated."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha cobrança mensal, trimestral ou anual para que as próximas cobranças sejam calculadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha faturação mensal, trimestral ou anual para que os próximos débitos sejam calculados."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige facturación mensual, trimestral o anual para que se calculen los próximos cargos."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies maandelijkse, kwartaal- of jaarlijkse facturering zodat aankomende kosten worden berekend."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle monatliche, quartalsweise oder jährliche Abrechnung, damit anstehende Buchungen berechnet werden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une facturation mensuelle, trimestrielle ou annuelle pour que les prochains prélèvements soient calculés."
          }
        }
      }
    },
    "subscriptions.empty.step2.title": {
