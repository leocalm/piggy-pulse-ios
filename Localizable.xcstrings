    "deleteAccount.confirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and all data will be permanently deleted. This cannot be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta e todos os dados serão excluídos permanentemente. Isso não pode ser desfeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta e todos os dados serão eliminados permanentemente. Esta ação não pode ser revertida."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y todos los datos se eliminarán de forma permanente. Esto no se puede deshacer."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account en alle gegevens worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und alle Daten werden dauerhaft gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte et toutes vos données seront définitivement supprimés. Cette action est irréversible."
          }
        }
      }
    },
