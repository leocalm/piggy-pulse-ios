    "accounts.empty.tip1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add checking, savings, credit card, wallet, or allowance accounts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode adicionar contas corrente, poupança, cartão de crédito, carteira ou mesada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode adicionar contas à ordem, poupanças, cartões de crédito, carteiras ou contas de mesada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes añadir cuentas corrientes, cuentas de ahorro, tarjetas de crédito, monederos o cuentas de asignación."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt betaalrekeningen, spaarrekeningen, creditcards, portemonnees of toelagerekeningen toevoegen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Giro-, Spar-, Kreditkarten-, Wallet- oder Taschengeldkonten hinzufügen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajouter des comptes courants, des comptes d’épargne, des cartes de crédit, des portefeuilles ou des enveloppes dédiées."
          }
        }
      }
    },
    "accounts.empty.tip2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your current balance when creating an account — it updates as you add transactions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina seu saldo atual ao criar uma conta — ele é atualizado conforme você adiciona transações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o saldo atual ao criar uma conta — é atualizado à medida que adiciona transações."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece tu saldo actual al crear una cuenta: se actualiza a medida que añades movimientos."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je huidige saldo in bij het aanmaken van een rekening — het wordt bijgewerkt zodra je transacties toevoegt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege beim Erstellen eines Kontos den aktuellen Saldo fest — er wird mit jeder neuen Buchung aktualisiert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez votre solde actuel à la création d’un compte — il se met à jour à mesure que vous ajoutez des transactions."
          }
        }
      }
    },
    "accounts.empty.tip3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts you no longer use can be archived to keep your list focused."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas que você não usa mais podem ser arquivadas para manter sua lista organizada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas que já não utiliza podem ser arquivadas para manter a sua lista organizada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas que ya no usas pueden archivarse para mantener tu lista ordenada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekeningen die je niet meer gebruikt, kun je archiveren om je lijst overzichtelijk te houden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten, die du nicht mehr nutzt, kannst du archivieren, damit deine Liste übersichtlich bleibt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes que vous n’utilisez plus peuvent être archivés pour garder votre liste claire."
          }
        }
      }
    },
