    "tip.vendors.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händler stehen für die Orte, an denen du Geld ausgibst. Wenn du Buchungen mit Händlern verknüpfst, erkennst du Muster im Zeitverlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendors represent the places where you spend money. Linking transactions to vendors helps you see spending patterns over time."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comercios representan los lugares donde gastas. Vincular movimientos a comercios te ayuda a ver patrones de gasto en el tiempo."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bénéficiaires représentent les endroits où vous dépensez. Lier vos transactions aux bénéficiaires vous aide à voir les tendances de dépense dans le temps."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkopers staan voor de plekken waar je geld uitgeeft. Door transacties aan verkopers te koppelen, zie je patronen in je uitgaven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornecedores representam os locais onde você gasta dinheiro. Vincular transações a fornecedores ajuda a ver padrões de gastos ao longo do tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os comerciantes representam os locais onde gasta dinheiro. Associar transações a comerciantes ajuda-o a identificar padrões de gasto ao longo do tempo."
          }
        }
      }
    },
