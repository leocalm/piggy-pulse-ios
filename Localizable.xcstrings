    "auth.checkEmailDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists for that email, we've sent a password reset link. Check your inbox and spam folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se uma conta existir para esse e-mail, enviamos um link de redefinição de senha. Verifique sua caixa de entrada e pasta de spam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se existir uma conta com esse e-mail, enviámos um link para repor a palavra-passe. Verifique a caixa de entrada e o spam."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta con ese correo, te hemos enviado un enlace para restablecer la contraseña. Revisa tu bandeja de entrada y la carpeta de spam."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er een account met dat e-mailadres bestaat, hebben we een reset-link gestuurd. Controleer je inbox en spammap."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls ein Konto mit dieser E-Mail-Adresse existiert, haben wir einen Link zum Zurücksetzen gesendet. Prüfe Posteingang und Spam-Ordner."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe pour cette adresse, un lien de réinitialisation vous a été envoyé. Consultez votre boîte de réception et vos courriers indésirables."
          }
        }
      }
    },
