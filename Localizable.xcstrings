    "accounts.empty.step3.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recording transactions, select which account the money came from or went to."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registrar transações, selecione de qual conta o dinheiro veio ou para qual foi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registar transações, selecione de que conta saiu ou para que conta entrou o dinheiro."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrar movimientos, indica de qué cuenta sale o a qué cuenta entra el dinero."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef bij elke transactie aan van welke rekening het geld komt of naartoe gaat."
