          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne jugeons pas vos dépenses"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
