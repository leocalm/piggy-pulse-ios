    "tip.periods.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Periods are time windows for your budget — typically monthly. All transactions and budget targets are scoped to the active period."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Períodos são janelas de tempo para seu orçamento — geralmente mensais. Todas as transações e metas são vinculadas ao período ativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os períodos são janelas temporais para o seu orçamento — normalmente mensais. Todas as transações e metas são limitadas ao período ativo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los periodos son intervalos de tiempo para tu presupuesto, normalmente mensuales. Todos los movimientos y objetivos se aplican al periodo activo."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodes zijn tijdvensters voor je budget — meestal maandelijks. Alle transacties en doelen gelden binnen de actieve periode."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiträume sind Zeitfenster für dein Budget — meist monatlich. Alle Buchungen und Budgetziele gelten innerhalb des aktiven Zeitraums."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les périodes sont des fenêtres temporelles pour votre budget — généralement mensuelles. Toutes les transactions et tous les objectifs sont limités à la période active."
          }
        }
      }
    },
    "tip.periods.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget Periods"
          }
        },
        "pt-BR": {
