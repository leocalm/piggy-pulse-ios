    "onboarding.categories.createDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories organize your transactions. Start with at least one — you can always add more later."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias organizam suas transações. Comece com pelo menos uma — você pode adicionar mais depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias organizam as suas transações. Comece com pelo menos uma — pode sempre adicionar mais depois."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías organizan tus movimientos. Empieza con al menos una; siempre puedes añadir más después."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorieën ordenen je transacties. Begin met minstens één — je kunt er altijd later meer toevoegen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien strukturieren deine Buchungen. Beginne mit mindestens einer — du kannst später jederzeit weitere ergänzen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories organisent vos transactions. Commencez avec au moins une — vous pourrez en ajouter d’autres plus tard."
          }
        }
      }
    },
