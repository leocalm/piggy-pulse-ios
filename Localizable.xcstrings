    "tip.subscriptions.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos erfassen wiederkehrende Abbuchungen wie Streamingdienste, Mitgliedschaften und Rechnungen. Sobald du sie hier hinzufügst, siehst du anstehende Kosten auf einen Blick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions track recurring charges like streaming services, memberships, and bills. Adding them here helps you see upcoming costs."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones registran cargos recurrentes como servicios de streaming, membresías y facturas. Añadirlas aquí te ayuda a ver los próximos gastos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements suivent les prélèvements récurrents comme les services de streaming, les adhésions et les factures. Les ajouter ici vous aide à anticiper les prochains frais."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen volgen terugkerende kosten zoals streamingdiensten, lidmaatschappen en facturen. Door ze hier toe te voegen, zie je aankomende kosten in één oogopslag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinaturas rastreiam cobranças recorrentes como serviços de streaming, mensalidades e contas. Adicioná-las aqui ajuda a ver custos futuros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As subscrições acompanham débitos recorrentes como serviços de streaming, adesões e contas. Adicioná-las aqui ajuda-o a antecipar os próximos custos."
          }
        }
      }
    },
