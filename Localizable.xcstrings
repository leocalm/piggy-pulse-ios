    "accounts.description1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where does your money live? Accounts represent your real accounts, and are not connected to your bank."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde está seu dinheiro? As contas representam suas contas reais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde está o seu dinheiro? As contas representam as suas contas reais e não estão ligadas ao banco."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde está tu dinero? Las cuentas representan tus cuentas reales, pero no están conectadas a tu banco."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar staat je geld? Rekeningen vertegenwoordigen je echte rekeningen en zijn niet aan je bank gekoppeld."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo liegt dein Geld? Konten bilden deine echten Konten ab, sind aber nicht mit deiner Bank verbunden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Où se trouve votre argent ? Les comptes correspondent à vos vrais comptes, sans connexion à votre banque."
          }
        }
      }
    },
    "accounts.description2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add as many as you'd like — or skip and add them later."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione quantas quiser — ou avance e adicione mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione quantas quiser — ou avance e adicione-as mais tarde."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tantas como quieras o sáltatelo y añádelas más tarde."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg er zoveel toe als je wilt — of sla over en voeg ze later toe."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge so viele hinzu, wie du möchtest — oder überspringe diesen Schritt und ergänze sie später."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en autant que nécessaire, ou passez cette étape et ajoutez-les plus tard."
          }
        }
      }
    },
