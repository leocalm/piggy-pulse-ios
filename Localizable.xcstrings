    "tip.accounts.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten zeigen, wo dein Geld liegt — Girokonto, Sparkonto, Kreditkarten oder Wallets. Die Salden werden mit jeder neuen Buchung aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts represent where your money is held — checking, savings, credit cards, or wallets. Their balances are updated as you add transactions."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas representan dónde guardas tu dinero: cuentas corrientes, cuentas de ahorro, tarjetas de crédito o monederos. Sus saldos se actualizan a medida que añades movimientos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes représentent l’endroit où se trouve votre argent : compte courant, épargne, cartes de crédit ou portefeuilles. Leur solde est mis à jour à mesure que vous ajoutez des transactions."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekeningen laten zien waar je geld staat — betaalrekening, spaarrekening, creditcards of portemonnees. Saldi worden bijgewerkt zodra je transacties toevoegt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas representam onde seu dinheiro está — corrente, poupança, cartões de crédito ou carteiras. Seus saldos são atualizados conforme você adiciona transações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas representam onde guarda o seu dinheiro — conta à ordem, poupanças, cartões de crédito ou carteiras. Os saldos são atualizados à medida que adiciona transações."
          }
        }
      }
    },
