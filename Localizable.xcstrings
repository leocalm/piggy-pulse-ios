    "tip.dashboard.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Übersicht zeigt eine Momentaufnahme deiner Finanzen für den ausgewählten Zeitraum. Über die Schaltfläche „Anpassen“ wählst du Widgets aus und ordnest sie neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dashboard shows a snapshot of your finances for the selected period. Use the Customize button to choose which widgets to display and reorder them."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu panel muestra una instantánea de tus finanzas para el periodo seleccionado. Usa el botón Personalizar para elegir y reordenar los widgets."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre tableau de bord présente un instantané de vos finances pour la période sélectionnée. Utilisez le bouton Personnaliser pour choisir et réorganiser les widgets."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dashboard toont een momentopname van je financiën voor de gekozen periode. Gebruik de knop Aanpassen om widgets te kiezen en te herschikken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu painel mostra um resumo das suas finanças para o período selecionado. Use o botão Personalizar para escolher quais widgets exibir e reordená-los."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel mostra uma fotografia das suas finanças para o período selecionado. Use o botão Personalizar para escolher e reordenar os widgets."
          }
        }
      }
    },
