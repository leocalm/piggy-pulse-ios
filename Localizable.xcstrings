    "accounts.description1" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo liegt dein Geld? Konten bilden deine echten Konten ab, sind aber nicht mit deiner Bank verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where does your money live? Accounts represent your real accounts, and are not connected to your bank."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde está tu dinero? Las cuentas representan tus cuentas reales, pero no están conectadas a tu banco."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où se trouve votre argent ? Les comptes correspondent à vos vrais comptes, sans connexion à votre banque."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar staat je geld? Rekeningen vertegenwoordigen je echte rekeningen en zijn niet aan je bank gekoppeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde está seu dinheiro? As contas representam suas contas reais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde está o seu dinheiro? As contas representam as suas contas reais e não estão ligadas ao banco."
          }
        }
      }
    },
    "accounts.description2" : {
