    "tip.categories.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories help you organize your transactions and set budget targets. Create income and expense categories to define your budgeting structure."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorias ajudam a organizar suas transações e definir metas de orçamento. Crie categorias de receita e despesa para definir sua estrutura orçamentária."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias ajudam a organizar as suas transações e a definir metas de orçamento. Crie categorias de receita e despesa para estruturar o seu orçamento."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías te ayudan a organizar tus movimientos y a fijar objetivos de presupuesto. Crea categorías de ingreso y gasto para estructurar tu presupuesto."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorieën helpen je transacties te ordenen en budgetdoelen te stellen. Maak inkomsten- en uitgavencategorieën aan om de basis van je budget op te zetten."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien helfen dir, deine Buchungen zu ordnen und Budgetziele festzulegen. Lege Einnahme- und Ausgabekategorien an, um deine Budgetstruktur zu definieren."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories vous aident à organiser vos transactions et à définir des objectifs budgétaires. Créez des catégories de revenus et de dépenses pour structurer votre budget."
          }
        }
      }
    },
    "tip.categories.title": {
      "localizations": {
